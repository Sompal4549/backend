# Ensis backend — environment variables
# Copy to .env and fill in. Never commit the real .env.
# On start-up the server checks these: unsafe production settings stop it, missing services log [env] warnings.

# ── Server ──────────────────────────────────────────────────────────────
# development | production  (production turns off every dev shortcut: master OTP/2FA codes, /admin/login/dev)
NODE_ENV=production
PORT=5000
# Public website address, used in links inside emails and the dashboard
SITE_URL=https://ensis.in

# ── Database ────────────────────────────────────────────────────────────
MONGO_URI_MAIN=mongodb+srv://USER:PASSWORD@HOST/ensis
# Only used by local seed scripts (npm run seed:*:local)
MONGO_URI_LOCAL=mongodb://localhost:27017/ensis

# ── Auth ────────────────────────────────────────────────────────────────
# Long random strings (e.g. `openssl rand -hex 48`). Required in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# true in production (HTTPS only cookies); false on http://localhost
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Extra allowed browser origins, comma separated. The website/admin domains and *.ensis.in are always allowed.
CORS_ORIGIN=https://ensis.in,https://admin.ensis.in

# ── OTP ─────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=10
OTP_RESEND_LIMIT=5
OTP_RESEND_WINDOW_MINUTES=30
# Test phone numbers that log in with OTP_BYPASS_OTP — development only.
OTP_BYPASS_NUMBERS=
OTP_BYPASS_OTP=
# Keep false: when true the test numbers above also work on the live site
OTP_BYPASS_IN_PRODUCTION=false

# ── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@ensis.in
FROM_NAME=Ensis

# ── WhatsApp (Opus) ─────────────────────────────────────────────────────
WHATSAPP_PROVIDER=opus
OPUS_API_KEY=
# Sender number registered with Opus
ADMIN_WHATSAPP_NUMBER=

# ── Payments (Razorpay) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks → secret. Without it webhooks are rejected and
# orders whose customer closed the tab after paying stay "pending".
RAZORPAY_WEBHOOK_SECRET=

# ── Media (Cloudinary) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI chatbot (one of these) ───────────────────────────────────────────
GEMINI_API_KEY=
# Optional; used instead of Gemini when set
OPENAI_API_KEY=
