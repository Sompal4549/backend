# Ensis backend — environment variables
# Copy to .env and fill in. Never commit the real .env.
# On start-up the server checks these: unsafe production settings stop it, missing services log [env] warnings.

# ── Server ──────────────────────────────────────────────────────────────
# development | production  (outside production, generated OTPs are also printed to the server console)
NODE_ENV=production
PORT=5000
# Public website address, used in links inside emails and the dashboard
SITE_URL=https://ensis.in

# ── Database ────────────────────────────────────────────────────────────
MONGO_URI_MAIN=mongodb+srv://USER:PASSWORD@HOST/ensis
# Only used by local seed scripts (npm run seed:*:local)
MONGO_URI_LOCAL=mongodb://localhost:27017/ensis

# ── Auth ────────────────────────────────────────────────────────────────
# Long random strings (e.g. `openssl rand -hex 48`). Required in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# true in production (HTTPS only cookies); false on http://localhost
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Extra allowed browser origins, comma separated. The website/admin domains and *.ensis.in are always allowed.
CORS_ORIGIN=https://ensis.in,https://admin.ensis.in

# ── OTP ─────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=10
OTP_RESEND_LIMIT=5
OTP_RESEND_WINDOW_MINUTES=30

# ── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@ensis.in
FROM_NAME=Ensis

# ── WhatsApp (Opus) ─────────────────────────────────────────────────────
WHATSAPP_PROVIDER=opus
OPUS_API_KEY=
# Sender number registered with Opus
ADMIN_WHATSAPP_NUMBER=

# ── Payments (Razorpay) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks → secret. Without it webhooks are rejected and
# orders whose customer closed the tab after paying stay "pending".
RAZORPAY_WEBHOOK_SECRET=

# ── Media (Cloudinary) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI (chatbot, CV screening, photo check, job descriptions, infra reports) ──
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=

# ── Google Business Profile (admin → Google Reviews) ───────────────────
# Optional. Until all four are set, the Google Reviews page shows "not configured" and never sample data.
# OAuth client from Google Cloud Console (APIs & Services → Credentials → OAuth client ID, type "Web application").
# The project also needs Google Business Profile API access approved by Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g. https://api.ensis.in/api/v1/gbp/oauth/callback
GBP_REDIRECT_URI=
# Encrypts stored OAuth tokens (AES-256-GCM). Base64 of 32 random bytes: `openssl rand -base64 32`.
# Shared with infrastructure credential storage — do not change it once tokens are stored.
ENCRYPTION_MASTER_KEY=
